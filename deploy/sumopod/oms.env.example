# Template only. Real values come from the Sumopod secret store; production refuses to start with dev defaults.
OMS_ENV=staging
OMS_DB_ROLE_MODE=v31
OMS_DATABASE_URL=postgresql+psycopg://oms_app:<secret>@<host>:5432/oms
OMS_WORKER_DATABASE_URL=postgresql+psycopg://oms_worker:<secret>@<host>:5432/oms
OMS_WEBHOOK_DATABASE_URL=postgresql+psycopg://oms_webhook:<secret>@<host>:5432/oms
OMS_JWT_SECRET=<secret, >= 32 chars>
OMS_CREDENTIALS_MASTER_KEY=<fernet key from secret store>
OMS_CREDENTIALS_PREVIOUS_KEYS=
OMS_META_APP_SECRET=<secret>
OMS_META_VERIFY_TOKEN=<secret>
OMS_CHATWOOT_WEBHOOK_SECRET=<secret>
OMS_DOKU_NOTIFICATION_SECRET=<secret>
OMS_BITESHIP_WEBHOOK_TOKEN=<secret>
OMS_METRICS_TOKEN=<secret>
# Live provider access stays OFF: platform_accounts.live_enabled is false for every account and live marketplace
# adapters are refused in code until verification gates close (docs/25).
